{
  "name": "react-native-keycard",
  "version": "1.0.4",
  "description": "A React Native library to interact with Keycard using NFC connection",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "test": "jest",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "author": "Ksenia Balistreri",
  "license": "MIT",
  "homepage": "https://github.com/choppu/react-native-keycard#readme",
  "dependencies": {
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "buffer": "^6.0.3",
    "del-cli": "^8.0.1",
    "jest": "^30.5.2",
    "keycard-sdk": "^4.0.1",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "release-it": "^21.1.0",
    "turbo": "^2.11.6",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "keycard-sdk": "^4.0.1",
    "react": ">=19.0.0",
    "react-native": ">=0.85.0"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "KeycardSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.keycard"
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|keycard-sdk)/)"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    }
  }
}
